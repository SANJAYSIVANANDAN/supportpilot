      "lastName": "Agent",
      "credentials": [
        {
          "type": "password",
          "value": "agent1pass",
          "temporary": false
        }
      ],
      "realmRoles": ["agent"]
    },
    {
      "username": "admin1",
      "enabled": true,
      "email": "admin1@example.com",
      "firstName": "Admin",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "admin1pass",
          "temporary": false
        }
      ],
