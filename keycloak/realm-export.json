{
  "realm": "support",
  "enabled": true,
  "roles": {
    "realm": [
      { "name": "agent", "description": "Support agent role" },
      { "name": "admin", "description": "Admin role" }
    ]
  },
  "clients": [
    {
      "clientId": "support-api",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "changeme",
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "defaultClientScopes": ["openid", "profile", "email"]
    },
    {
      "clientId": "support-frontend",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "changeme-frontend",
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "redirectUris": ["*"],
      "webOrigins": ["*"],
      "defaultClientScopes": ["openid", "profile", "email"]
