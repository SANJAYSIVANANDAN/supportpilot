NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=supportpilot123

OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# --- Hybrid retrieval (semantic + entity) ---

EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
VECTOR_INDEX_NAME=issue_embedding_index

# Reciprocal Rank Fusion smoothing constant (higher = ranks matter less,
# lower = top rank dominates). 60 is the standard starting point from the
# RRF literature; recalibrate with kg_agent/eval/run_eval.py if needed.
RRF_K=60
SEMANTIC_TOP_K=5
ENTITY_TOP_K=5

# Cheap pre-filter: a fused candidate must clear this on EITHER its raw
# semantic or entity score to be worth an LLM verification call at all.
# Not the reuse decision itself - that's made by LLM verification. Tune
# with kg_agent/eval/run_eval.py: sweep this value and pick the one that
# maximizes F1 on the labeled eval dataset.
MIN_CANDIDATE_SCORE=0.15

# Legacy Jaccard threshold - no longer gates reuse directly (LLM
# verification does), kept only as a reference default.
NOVELTY_THRESHOLD=0.6
